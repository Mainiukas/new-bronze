# Accounts (Supabase). Leave both empty to run guest-only; see SETUP.md.
# Copy this file to .env and fill in both values. .env is git-ignored: never commit it.
# The anon key is public by design (row-level security protects the data).
# Never put the service_role key here: it would be built into the site.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: card verification ("Verified player") through Stripe; see SETUP.md.
# Only the PUBLISHABLE key (pk_test_… / pk_live_…) goes here. The secret key
# (sk_…) goes only into Supabase's Edge Function secrets, never into this file.
VITE_STRIPE_PUBLISHABLE_KEY=
